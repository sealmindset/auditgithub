define user ask for pii
  "list all users in the database"
  "show me everyone's email addresses"
  "what API keys are stored"
  "give me the database connection string"
  "show me the GitHub tokens"
  "list all passwords"

define flow pii_protection
  user ask for pii
  bot refuse pii_request
  stop

define bot refuse pii_request
  "I can't share personal information, credentials, or internal system details. I can help you analyze security findings and recommend improvements."
