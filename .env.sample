# =============================================================================
# AuditGH Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# To generate a hex string of 32 characters for secrets/JWT:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub Configuration
# -----------------------------------------------------------------------------
# Define your GitHub organizations and their PATs here.
# Format: ORG_{NAME}_TOKEN and ORG_{NAME}_GITHUB for each organization.
#
# The system automatically loads these on startup and stores them securely.
# Then just use: --target orgname to scan that organization.
# -----------------------------------------------------------------------------

# Default organization (used when no --target specified)
GITHUB_ORG=sealmindset
GITHUB_TOKEN=ghp_your_default_token
GITHUB_API=https://api.github.com

# -----------------------------------------------------------------------------
# Additional Organizations
# -----------------------------------------------------------------------------
# Add more organizations by following this pattern:
#   ORG_{NAME}_TOKEN=ghp_xxx
#   ORG_{NAME}_GITHUB=github-org-name
#
# Example for "acme" organization:
#   ORG_ACME_TOKEN=ghp_acme_token_here
#   ORG_ACME_GITHUB=acme-corp
#
# Then scan with: --target acme
# -----------------------------------------------------------------------------

# Organization: acme
#ORG_ACME_TOKEN=ghp_your_acme_token
#ORG_ACME_GITHUB=acme-corp

# Organization: clientx  
#ORG_CLIENTX_TOKEN=ghp_your_clientx_token
#ORG_CLIENTX_GITHUB=clientx-org

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# These are used by Docker Compose for the PostgreSQL container
POSTGRES_USER=auditgh
POSTGRES_PASSWORD=auditgh_secret
POSTGRES_DB=auditgh_kb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Legacy DATABASE_URL (optional - POSTGRES_* vars take precedence in containers)
# DATABASE_URL=postgresql://auditgh:auditgh_secret@db:5432/auditgh_kb

# -----------------------------------------------------------------------------
# Multi-Organization Security
# -----------------------------------------------------------------------------
# Encryption key for secrets manager (32+ characters recommended)
# Generate with: LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
SECRETS_MASTER_KEY=change_this_to_a_secure_32char_key

# -----------------------------------------------------------------------------
# AI Provider Configuration (Optional)
# -----------------------------------------------------------------------------
# Choose your AI provider: openai, claude, ollama
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Scanning Configuration
# -----------------------------------------------------------------------------
# Skip automatic scan on container start
SKIP_SCAN=false

# Multi-tenant mode
MULTI_TENANT_MODE=true

# -----------------------------------------------------------------------------
# Web UI Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Scheduler Configuration
# -----------------------------------------------------------------------------
# Master switch for all scheduled jobs
SCHEDULER_ENABLED=true

# Data Integrity Agent (Self-Annealing)
ANNEALING_ENABLED=false
ANNEALING_CRON=0 3 * * *

# Automated Repository Scanning (full scan)
SCAN_ENABLED=false
SCAN_CRON=0 */6 * * *

# New Repo Auto-Scanner (scans repos that have never been scanned)
SCAN_NEW_REPOS_ENABLED=true
SCAN_NEW_REPOS_CRON=0 2 * * *

# Organization Backups
BACKUP_ENABLED=false
BACKUP_CRON=0 2 * * 0

# -----------------------------------------------------------------------------
# PostgREST Configuration (if using)
# -----------------------------------------------------------------------------
# PGRST_DB_URI=postgresql://auditgh:auditgh_secret@db:5432/auditgh_kb
# PGRST_DB_SCHEMA=api
# PGRST_DB_ANON_ROLE=web_anon
# PGRST_JWT_SECRET=your-jwt-secret-at-least-32-characters
