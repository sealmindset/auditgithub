# =============================================================================
# AuditGH Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# To generate a hex string of 32 characters for secrets/JWT:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub Configuration
# -----------------------------------------------------------------------------
# Define your GitHub organizations and their PATs here.
# Format: ORG_{NAME}_TOKEN and ORG_{NAME}_GITHUB for each organization.
#
# The system automatically loads these on startup and stores them securely.
# Then just use: --target orgname to scan that organization.
# -----------------------------------------------------------------------------

# Default organization (used when no --target specified)
GITHUB_ORG=example-org
GITHUB_TOKEN=ghp_your_default_token
GITHUB_API=https://api.github.com

# -----------------------------------------------------------------------------
# Additional Organizations
# -----------------------------------------------------------------------------
# Add more organizations by following this pattern:
#   ORG_{NAME}_TOKEN=ghp_xxx
#   ORG_{NAME}_GITHUB=github-org-name
#
# Example for "acme" organization:
#   ORG_ACME_TOKEN=ghp_acme_token_here
#   ORG_ACME_GITHUB=acme-corp
#
# Then scan with: --target acme
# -----------------------------------------------------------------------------

# Organization: acme
#ORG_ACME_TOKEN=ghp_your_acme_token
#ORG_ACME_GITHUB=acme-corp

# Organization: clientx  
#ORG_CLIENTX_TOKEN=ghp_your_clientx_token
#ORG_CLIENTX_GITHUB=clientx-org

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# These are used by Docker Compose for the PostgreSQL container
POSTGRES_USER=auditgh
POSTGRES_PASSWORD=auditgh_secret
POSTGRES_DB=auditgh_kb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Legacy DATABASE_URL (optional - POSTGRES_* vars take precedence in containers)
# DATABASE_URL=postgresql://auditgh:auditgh_secret@db:5432/auditgh_kb

# -----------------------------------------------------------------------------
# Multi-Organization Security
# -----------------------------------------------------------------------------
# Encryption key for secrets manager (32+ characters recommended)
# Generate with: LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
SECRETS_MASTER_KEY=change_this_to_a_secure_32char_key

# -----------------------------------------------------------------------------
# Authentication & Authorization (RBAC)
# -----------------------------------------------------------------------------
# Set to true to require authentication (false for dev mode)
AUTH_REQUIRED=false

# Break glass emergency password
# Change this in production!
BREAK_GLASS_PASSWORD=ChangeMe123!

# Break glass emergency login email
BREAK_GLASS_EMAIL=admin@example.com

# Admin email for Entra ID bootstrap
ADMIN_EMAIL=admin@company.example

# OIDC/SSO Configuration
# -------
# Generic OIDC provider (mock-oidc for development, or any OIDC-compliant IdP)
# In development, set OIDC_PROVIDER_NAME=mock-oidc and leave Entra/Okta blank.
# In production, leave OIDC_PROVIDER_NAME blank and configure Entra/Okta.
OIDC_PROVIDER_NAME=mock-oidc
OIDC_CLIENT_ID=auditgh-dev-client
OIDC_CLIENT_SECRET=auditgh-dev-secret
OIDC_DISCOVERY_URL=http://mock-oidc:10090/.well-known/openid-configuration
OIDC_EXTERNAL_BASE_URL=http://localhost:3007

# Entra ID (Microsoft) — production
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret

# Okta — production (optional)
#OKTA_DOMAIN=dev-12345.okta.com
#OKTA_CLIENT_ID=your-okta-client-id
#OKTA_CLIENT_SECRET=your-okta-client-secret

# Session configuration
SESSION_SECRET=change_this_to_a_secure_secret_at_least_32_characters

# -----------------------------------------------------------------------------
# SMTP Configuration for Email Invitations
# -----------------------------------------------------------------------------
# For development, use MailHog (included in docker-compose):
#   - MailHog web UI: http://localhost:8025
#   - SMTP server: localhost:1025 (no authentication required)
#
# For production, use a real SMTP service:
#   - Gmail: smtp.gmail.com:587 (requires app password)
#   - SendGrid: smtp.sendgrid.net:587
#   - AWS SES: email-smtp.us-east-1.amazonaws.com:587
# -----------------------------------------------------------------------------

# Development (MailHog - no auth required)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@auditgithub.local
SMTP_USE_TLS=false
SMTP_USE_SSL=false
APP_URL=http://localhost:3000

# Production Example (Gmail with App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=your-email@gmail.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# APP_URL=https://your-production-domain.com

# -----------------------------------------------------------------------------
# AI Provider Configuration (Optional)
# -----------------------------------------------------------------------------
# Choose your AI provider: openai, claude, ollama
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# AI Safety Controls
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=30
AI_MAX_PROMPT_CHARS=10000
AI_PII_MASKING_ENABLED=true

# SSL Verification (set to false for environments with self-signed certs)
SSL_VERIFY=true

# Bind address (0.0.0.0 for Docker, 127.0.0.1 for local dev)
BIND_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Scanning Configuration
# -----------------------------------------------------------------------------
# Skip automatic scan on container start
SKIP_SCAN=false

# Multi-tenant mode
MULTI_TENANT_MODE=true

# -----------------------------------------------------------------------------
# Web UI Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Deployment URLs (override for cloud deployment)
# -----------------------------------------------------------------------------
# Frontend URL (used for invitation links in emails and API responses)
# APP_URL=http://localhost:3000
# CORS allowed origins (comma-separated; only needed to override defaults)
# CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com
# OpenAPI documentation server URLs
# API_SERVER_URL=http://localhost:8000
# API_SERVER_URL_PROD=https://api.yourdomain.com
# Sandbox/dev portal URLs
# SANDBOX_API_URL=http://localhost:8001
# SWAGGER_EDITOR_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Scheduler Configuration
# -----------------------------------------------------------------------------
# Master switch for all scheduled jobs
SCHEDULER_ENABLED=true

# Data Integrity Agent (Self-Annealing)
ANNEALING_ENABLED=false
ANNEALING_CRON=0 3 * * *

# Automated Repository Scanning (full scan)
SCAN_ENABLED=false
SCAN_CRON=0 */6 * * *

# New Repo Auto-Scanner (scans repos that have never been scanned)
SCAN_NEW_REPOS_ENABLED=true
SCAN_NEW_REPOS_CRON=0 2 * * *

# Organization Backups
BACKUP_ENABLED=false
BACKUP_CRON=0 2 * * 0

# -----------------------------------------------------------------------------
# Sandbox Configuration
# -----------------------------------------------------------------------------
# Developer sandbox mode (runs on port 8001 with dummy data)
SANDBOX_MODE=false
SANDBOX_AUTO_RESET_HOURS=24

# -----------------------------------------------------------------------------
# PostgREST Configuration (if using)
# -----------------------------------------------------------------------------
# PGRST_DB_URI=postgresql://auditgh:auditgh_secret@db:5432/auditgh_kb
# PGRST_DB_SCHEMA=api
# PGRST_DB_ANON_ROLE=web_anon
# PGRST_JWT_SECRET=your-jwt-secret-at-least-32-characters

# -----------------------------------------------------------------------------
# Jira issue filing (web-ui)
# -----------------------------------------------------------------------------
# A credential-free deep link: the browser prefills Jira's own create screen
# and the user presses Create there. No token is involved, which is why these
# are safe to serve to the browser via /api/jira-config.
#
# These are Jira's NUMERIC internal IDs, not keys. The prefill endpoint rejects
# a project key. Read them from your instance:
#   GET /rest/api/3/project/<KEY>           -> id
#   GET /rest/api/3/issue/createmeta        -> issuetypes[].id
#   GET /rest/api/3/priority                -> id per priority name
# The button stays disabled, naming the missing variables, until the first
# three are set.
JIRA_BASE_URL=
JIRA_PROJECT_ID=
JIRA_ISSUE_TYPE_ID=
# Optional. Without these the issue carries the priority name only.
JIRA_PRIORITY_CRITICAL=
JIRA_PRIORITY_HIGH=
JIRA_PRIORITY_MEDIUM=
JIRA_PRIORITY_LOW=
JIRA_PRIORITY_INFO=

# -----------------------------------------------------------------------------
# AuditBoard GRC issue filing (api)
# -----------------------------------------------------------------------------
# Not a deep link. AuditBoard has no prefill-a-form URL, so filing is an
# authenticated API write performed by the api service. The token is read only
# there, is never returned by /findings/auditboard/config, and must never be
# given an NEXT_PUBLIC_ prefix — Next.js inlines those into the client bundle,
# which would ship this token to every browser that loads the app.
AUDITBOARD_URL=
AUDITBOARD_TOKEN=
# Issue category the created issue is filed under. Two shapes are supported,
# and only categories verified against this instance are accepted — filing
# blind into a GRC register produces records nobody can delete.
#
#   10  IT Risk Issue            — attaches to a Risk record; set
#                                  AUDITBOARD_ISSUE_SOURCE_ID below
#   11  IT Risk Exception        — standalone, no source needed
#   12  IT Infrastructure Exception — standalone, no source needed
#
# 11 and 12 have an empty `key` and hold a standalone issue. 10 carries the key
# "it-risk-mitigation-plan": all 427 issues already in it point at a Risk, so
# the category is usable as long as the risk is named.
AUDITBOARD_ISSUE_CATEGORY_ID=10
# Required for category 10. The Risk the findings are filed under. 406 is
# SCF-R-EX-6 "EX-6 Unmitigated vulnerabilities", where the existing
# scanner-shaped issues live. Leave 0 for a standalone category.
AUDITBOARD_ISSUE_SOURCE_ID=406
# Workspace number that appears in an issue URL:
#   {AUDITBOARD_URL}/workspace/{n}/issues/issue/{id}
# Confirmed from a working browser URL, not from the API — /api/v1/workspaces
# lists three workspaces and excludes this one by type, and neither an issue
# nor its source risk carries a workspace field. Filing works without this;
# leaving it 0 just means no clickable link is recorded. It cannot be verified
# by fetching, because AuditBoard is a single-page app and returns HTTP 200
# for any path.
AUDITBOARD_WORKSPACE_ID=5
# Status new issues are created in. This instance has six, counted over all
# 28,644 issues: Closed 22,940, Inactive 2,232, Pending Remediation 1,643,
# Open 1,488, Remediated 248, Canceled 93. "Draft" is not one of them, and a
# status that does not exist is answered with a bare HTTP 500.
AUDITBOARD_CREATE_STATUS=Open
# AuditBoard user IDs stamped on each filed issue. Category 10 lists
# seniorOwnerUser and vicePresidentUser among the fields required to sit at
# status Open — see issue_required_fields on GET /api/v1/issue_categories —
# and the API enforces none of them, so leaving these at 0 files a record that
# is in the register but incomplete. AuditGitHub logins and AuditBoard users
# are separate identities with no mapping, so there is nothing to derive these
# from. Read the IDs off an existing issue in the register, or from
# GET /api/v1/users.
AUDITBOARD_SENIOR_OWNER_USER_ID=0
AUDITBOARD_VICE_PRESIDENT_USER_ID=0
# Optional. Not required by the category, but every hand-filed issue in the
# register carries them, and a register entry with no named tester reads as
# nobody's work.
AUDITBOARD_TESTER_USER_ID=0
AUDITBOARD_REVIEWER_USER_ID=0
# How the issue was identified. 7 = Other, the honest answer for a scanner.
AUDITBOARD_ISSUE_IDENT_ID=7
# Required. Egress reaches this host two ways — intercepted by Zscaler, or
# direct to AWS — so the bundle must carry both trust anchors. Build it with:
#   docker compose exec api cat \
#     /usr/local/lib/python3.11/site-packages/certifi/cacert.pem > certs/auditboard-ca.pem
#   security find-certificate -a -c Zscaler -p /Library/Keychains/System.keychain \
#     >> certs/auditboard-ca.pem
# Disabling verification is not the alternative: these requests carry a bearer
# token. Filing refuses to run until this is set. certs/ is gitignored and the
# repo root is mounted at /app.
AUDITBOARD_CA_BUNDLE=/app/certs/auditboard-ca.pem
