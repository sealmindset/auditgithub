FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
#
# The pango/cairo/harfbuzz/gdk-pixbuf group is WeasyPrint's text-shaping and rasterising
# backend, loaded through ctypes at import time — without them `import weasyprint` raises
# OSError and every PDF export returns 500.
#
# The font packages are equally load-bearing and less obvious: python:3.11-slim ships no
# fonts whatsoever, so a container that renders "successfully" produces a PDF of empty
# boxes. DejaVu covers text; Symbola and Noto Sans Symbols2 cover the ✅/⚠️/🔴 status
# markers used throughout the hunt corpus, which rendered as tofu in earlier exports.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    git \
    graphviz \
    python3-dev \
    curl \
    ca-certificates \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    fonts-dejavu-core \
    fonts-noto-color-emoji \
    # Monochrome outlines for the ✅/⚠️/🔴 marks the report templates use. Noto Color
    # Emoji stores those as CBDT bitmaps, which WeasyPrint embeds and then draws as
    # nothing: the mark occupies its width and shows blank, on a page that reports no
    # error. These two supply the same codepoints as ordinary outline glyphs and the
    # stylesheet fences them by unicode-range — Symbola for most of the set, Noto Sans
    # Symbols2 (from fonts-noto-core) for 🟠🟡🟢🟣 and the rest of Unicode 12+, which
    # Symbola predates. Neither alone covers the corpus; the render tests enumerate it.
    # fonts-noto-color-emoji stays as the last resort for anything outside both fences.
    fonts-symbola \
    fonts-noto-core \
    && rm -rf /var/lib/apt/lists/* \
    # Bake the font cache into the layer. Without it the first process to render builds
    # the cache as it goes, and the set of fonts fontconfig can see changes *during* that
    # process — so a worker's first exported PDF differs by a byte from every later
    # export of the same report. The output is correct either way, which is what makes it
    # hard to notice, but "the same input renders to the same bytes" is the property that
    # lets a reader tell a re-export from an edited document.
    && fc-cache --force --system-only

# Trust corporate TLS-inspection root CAs (e.g. Zscaler) so pip, curl and git can
# reach upstream registries from behind the proxy. Without this the build fails at
# `pip install` with CERTIFICATE_VERIFY_FAILED, and the tempting fix —
# --trusted-host — disables verification for the whole install, so a proxy that can
# already see the traffic could also alter the packages. Trusting the CA keeps
# verification on. Same block as Dockerfile.scanner; certs/ is tracked as an
# empty directory so this is a no-op where no interception is in play.
COPY certs/ /usr/local/share/ca-certificates/extra/
RUN update-ca-certificates
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt \
    GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt

# Install Syft
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ /app/src/
COPY scripts/ /app/scripts/
COPY migrations/ /app/migrations/
COPY alembic.ini /app/alembic.ini

# Set python path
ENV PYTHONPATH=/app

# Entrypoint runs migrations + seeds before starting the app
# Note: volume mount .:/app overrides /app at runtime in dev,
# so the entrypoint must be at a path that exists on the host too.
ENTRYPOINT ["/app/scripts/docker-entrypoint.sh"]

# Run the application
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
