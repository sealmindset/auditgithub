# Local dev files
.scan_resume_state.pkl
.planning/
.cache/
backups/
generated_architectures/

# Scanner output. exports/ is hundreds of megabytes and contains the plaintext
# secrets the scanner recovered from the estate; shipping it into the build
# context would both slow every build and bake those credentials into image
# layers, where a `docker save` or a registry push would carry them off-host.
exports/
.try-it-screenshots/

# certs/ and vendor/ are deliberately NOT ignored here: the images COPY both, and
# excluding them from the build context turns the COPY into a hard build failure.

# Node modules (web-ui)
src/web-ui/node_modules/
src/web-ui/.next/
