# =============================================================================
# AuditGH Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env with real credentials to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
SESSION_SECRET=change-me-in-prod
AUTH_DISABLED=true
SKIP_SCAN=false
AI_AGENT_ENABLED=true

# -----------------------------------------------------------------------------
# Multi-Tenant Configuration
# -----------------------------------------------------------------------------
MULTI_TENANT_ENABLED=true
# DEFAULT_TENANT_SLUG=default  # Optional: slug for default tenant

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------
# Uncomment ONE of the following AI providers:

# Option 1: Claude (Anthropic Personal)
# Obtain from: https://console.anthropic.com/settings/keys
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option 2: Azure AI Foundry (Anthropic via Azure)
# Obtain from: Azure Portal → AI Foundry → Keys and Endpoint
AI_PROVIDER=anthropic_foundry
CLAUDE_CODE_USE_FOUNDRY=1
AZURE_AI_FOUNDRY_ENDPOINT=https://your-aifoundry.services.ai.azure.com/anthropic
AZURE_AI_FOUNDRY_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_FOUNDRY_BASE_URL=https://your-aifoundry.services.ai.azure.com/anthropic
ANTHROPIC_FOUNDRY_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_DEFAULT_SONNET_MODEL=cogdep-aifoundry-dev-eus2-claude-sonnet-4-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=cogdep-aifoundry-dev-eus2-claude-haiku-4-5
ANTHROPIC_DEFAULT_OPUS_MODEL=cogdep-aifoundry-dev-eus2-claude-opus-4-5

# Option 3: OpenAI
# Obtain from: https://platform.openai.com/api-keys
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# OPENAI_MODEL=gpt-4o

# Option 4: Ollama (Local)
# Install from: https://ollama.ai
# AI_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# Option 5: Docker AI (Local)
# First pull model: docker model pull ai/qwen3
# AI_PROVIDER=docker
# DOCKER_BASE_URL=http://host.docker.internal:12434
# DOCKER_MODEL=ai/qwen3

# -----------------------------------------------------------------------------
# GitHub Configuration - PRIMARY ORGANIZATION
# -----------------------------------------------------------------------------
# Obtain from: GitHub Settings → Developer settings → Personal access tokens
# URL: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user
#
# These credentials are used for the first/default organization.
# The organization is AUTO-CREATED when the API starts and detects these credentials.
#
# IMPORTANT: Organizations are NOT pre-populated in the database.
# They are created dynamically when:
#   1. Credentials are found in environment variables (on API startup)
#   2. User runs: python3 scan_repos.py --create-org NAME --github-org ORG --token TOKEN

GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_ORG=your-github-org

# Corporate/Enterprise GitHub token (if accessing separate org)
CORP_GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CORP_GITHUB_ORG=your-corp-github-org

# GitHub API endpoint (use enterprise URL if applicable)
GITHUB_API=https://api.github.com

# -----------------------------------------------------------------------------
# Additional Organizations (Optional)
# -----------------------------------------------------------------------------
# Add more organizations using the ORG_{NAME}_TOKEN pattern.
# Organizations are AUTO-REGISTERED when the API starts and detects these credentials.
#
# The NAME in ORG_{NAME}_TOKEN becomes the organization's internal name.
# The GITHUB value is the actual GitHub organization to scan.
#
# Example for "acme" organization:
#   ORG_ACME_TOKEN=ghp_acme_token_here
#   ORG_ACME_GITHUB=acme-corp
#
# Example for "mycompany" organization:
#   ORG_MYCOMPANY_TOKEN=ghp_mycompany_token_here
#   ORG_MYCOMPANY_GITHUB=my-company-org
#
# To start with NO organizations, comment out or remove all GITHUB_TOKEN/ORG_* variables.

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
# The database is automatically created on first run.
# Use consistent credentials across all services.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auditgh_kb

# Full connection string (must match above values)
DATABASE_URL=postgres://postgres:postgres@db:5432/auditgh_kb

# -----------------------------------------------------------------------------
# Scanner Configuration
# -----------------------------------------------------------------------------
SCANNER_IMAGE=auditgh-scanner:latest
CODEQL_RAM_MIB=16384
CODEQL_THREADS=1

# OSS Scanner defaults
SYFT_FORMAT=cyclonedx-json
GRYPE_SCAN_MODE=both

# -----------------------------------------------------------------------------
# Seeding/Worker Configuration
# -----------------------------------------------------------------------------
OSS_MAX_WORKERS=3
LINECOUNT_MAX_WORKERS=3
ENGAGEMENT_MAX_WORKERS=3
SEED_INTERVAL=3600
SEED_LANGLOC_INTERVAL=86400

# -----------------------------------------------------------------------------
# Optional: JIRA Integration
# -----------------------------------------------------------------------------
# Obtain from: Jira Account Settings → Security → API Tokens
# URL: https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_TOKEN=ATATT3xFfGF0XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# JIRA_URL=https://your-company.atlassian.net
# JIRA_EMAIL=your-email@company.com

# -----------------------------------------------------------------------------
# Redis Configuration (RBAC Permission Caching)
# -----------------------------------------------------------------------------
# Redis is used for caching RBAC permission lookups (5-minute TTL)
# This improves performance by >100ms per request
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Self-Annealing / Scheduled Tasks
# -----------------------------------------------------------------------------
# Enable the built-in scheduler for automated maintenance tasks
SCHEDULER_ENABLED=true

# Data Integrity Agent - Detects and repairs missing data
# Cron format: minute hour day month weekday
# Default: Daily at 3 AM
ANNEALING_CRON=0 3 * * *
ANNEALING_ENABLED=true
ANNEALING_DRY_RUN=false

# Scan Scheduler - Automated repository scanning
# Default: Every 6 hours
SCAN_CRON=0 */6 * * *
SCAN_ENABLED=false
SCAN_TARGET=  # Leave empty to scan current org, or specify org name

# Backup Scheduler - Automated organization backups
# Default: Weekly on Sunday at 2 AM
BACKUP_CRON=0 2 * * 0
BACKUP_ENABLED=false
BACKUP_ALL_ORGS=true

# -----------------------------------------------------------------------------
# MinIO Log Storage Configuration
# -----------------------------------------------------------------------------
# MinIO credentials for centralized log storage (S3-compatible)
# CHANGE IN PRODUCTION - these are development defaults
MINIO_ROOT_USER=auditgh
MINIO_ROOT_PASSWORD=auditgh_logs_2024_CHANGE_IN_PROD
MINIO_ENDPOINT=localhost:9009
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# -----------------------------------------------------------------------------
# Audit Logging Configuration
# -----------------------------------------------------------------------------
# Cribl integration for centralized logging
# Cribl forwards all application logs (INFO+) and audit events
# Set CRIBL_ENABLED=false for local development without Cribl
CRIBL_ENABLED=true
# Minimum log level for application logs (DEBUG, INFO, WARNING, ERROR)
AUDIT_LOG_LEVEL=INFO

# Cribl Sensitive Data Redaction (Phase 6)
# Automatically redacts passwords, tokens, API keys, secrets, emails from logs
# Set to false ONLY for local development debugging
CRIBL_REDACT_SENSITIVE=true

# -----------------------------------------------------------------------------
# Security Master Key for Database Encryption
# -----------------------------------------------------------------------------
# Master encryption key for secrets stored in database
# CRITICAL: Must be exactly 32 characters for AES-256 encryption
# Generate with: openssl rand -base64 32 | cut -c1-32
SECRETS_MASTER_KEY=auditgh_dev_secrets_key_32chars

# -----------------------------------------------------------------------------
# To generate a secure session secret key, run:
# LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Authentication (OIDC/SSO) Configuration
# -----------------------------------------------------------------------------
# Session secret for OAuth flow state management
# Generate with: openssl rand -hex 32
SESSION_SECRET=changeme-generate-with-openssl-rand-hex-32

# Microsoft Entra ID (formerly Azure AD)
# Obtain from: Azure Portal → App Registrations
ENTRA_TENANT_ID=your-tenant-id-here
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret

# Okta
# Obtain from: Okta Admin Console → Applications
OKTA_DOMAIN=dev-12345.okta.com
OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret

# JWT Token Configuration (Phase 5)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here-use-secrets-token-urlsafe-32
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Session Timeout Configuration (Phase 5)
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=30

# Frontend URL for CORS (Phase 5)
# Add production frontend URL here (e.g., https://auditgh.example.com)
FRONTEND_URL=https://auditgh.example.com

# Environment (affects HSTS header in production)
ENVIRONMENT=development  # Set to "production" to enable HSTS
