// 51 — IR: whose credentials are in play
//
// Purpose      This worm's objective is credentials: npm tokens, GitHub tokens, cloud keys
//              from the environment of whatever ran the install. Scoping the rotation list
//              is the second thing to do after a confirmed detection, and it must happen
//              BEFORE eradication — reimaging the device does not invalidate a token the
//              worm already exfiltrated, and it destroys the evidence of which tokens.
// Tables       DeviceInfo, DeviceProcessEvents, DeviceLogonEvents
// Permission   ThreatHunting.Read.All
//
// ROTATION ORDER (do not reorder — rotating after eradication leaves a live token in the
// attacker's hands during the gap):
//   1. Run this query, get the account list.
//   2. Revoke npm tokens for those accounts, then GitHub PATs / OAuth grants / SSH keys.
//   3. Rotate any cloud credentials present in the repo trees or shell environment.
//   4. Only then contain and reimage the device.
//
// SET TargetDevice from the alert.

let TargetDevice = "REPLACE-WITH-DEVICE-NAME";
let Lookback = 30d;
union withsource=SourceTable
  (
    // Who was logged on to the device at all
    DeviceInfo
    | where Timestamp > ago(Lookback)
    | where DeviceName =~ TargetDevice
    // Name the expanded column explicitly. `mv-expand parse_json(LoggedOnUsers)` does not
    // keep the original name — it produces a generated one, and the subsequent
    // LoggedOnUsers.UserName reference then resolves against the unexpanded dynamic value.
    | mv-expand LoggedOnUser = parse_json(LoggedOnUsers)
    | extend Account = tostring(LoggedOnUser.UserName),
             Domain  = tostring(LoggedOnUser.DomainName),
             Evidence = "logged-on user"
  ),
  (
    // Who ran package installs — these are the sessions whose environment the worm read
    DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where DeviceName =~ TargetDevice
    | where FileName in~ ("npm","npm.exe","npm-cli.js","node","node.exe","pnpm","yarn",
                          "bun","bun.exe")
    | extend Account = AccountName, Domain = AccountDomain,
             Evidence = strcat("ran: ", ProcessCommandLine)
  ),
  (
    // Interactive logons in the window
    DeviceLogonEvents
    | where Timestamp > ago(Lookback)
    | where DeviceName =~ TargetDevice
    | where ActionType == "LogonSuccess"
    | extend Account = AccountName, Domain = AccountDomain,
             Evidence = strcat("logon: ", LogonType)
  )
| where isnotempty(Account)
| summarize Occurrences  = count(),
            FirstSeen    = min(Timestamp),
            LastSeen     = max(Timestamp),
            EvidenceKinds = make_set(Evidence, 10),
            Sources      = make_set(SourceTable, 5)
    by Account, Domain
| order by Occurrences desc
| limit 200

// Follow-up, outside advanced hunting: for each account above, check GitHub audit log for
// token creation, workflow runs on the branch
// "dependabot/github_actions/format/setup-formatter", and any repo whose description is
// "Shai-Hulud: Here We Go Again" or whose name comes from Dune vocabulary (sardaukar,
// fremen, atreides ...) — those are the worm's exfil repos, not the victim's.
