// 16 — RULE: credential harvesting by a Bun-hosted payload
//
// Table        DeviceProcessEvents
// Confidence   HIGH — a Bun process shelling out to a cloud CLI purely to print a token
//              is the campaign's stated objective, not a side effect. Bun is a JavaScript
//              runtime; it has no reason to ask `gh` for an auth token.
// Source       Microsoft Security Blog, 2026-08-04, "ChainDrop supply chain compromise:
//              anatomy of a self-propagating worm" — credential access section.
//
// WHY THIS EXISTS SEPARATELY FROM 12
//
// Rule 12 catches Bun being STARTED by node. This catches what Bun then DOES. They fail
// independently: a variant that bootstraps Bun some other way defeats 12 and is still
// caught here, and a payload that harvests without ever touching a cloud CLI defeats this
// and is still caught by 12. Neither is a superset of the other, so neither replaces it.
//
// This is also the only rule in the set that fires on the objective rather than on the
// tooling, which makes it the one most likely to survive a rewrite of the loader.
//
// SHA256 IS NOT FILTERED ON HERE ON PURPOSE
//
// The three published hashes are already covered by rule 10. Requiring a known hash here
// would reduce this to a slower copy of that rule and lose the entire point: catching the
// build whose hash we do not have yet.
//
// GATE ON ARMING: baseline first. Developer laptops legitimately run `az account` and
// `gcloud config` constantly — the discriminator is the INITIATING process being Bun, not
// the command itself. If a build tool on this estate genuinely drives cloud CLIs through
// Bun, scope this to the device groups that do not rather than widening the filter.

let CredentialCommands = dynamic([
    "gh auth token",        // GitHub CLI — prints the OAuth token to stdout
    "gh auth status",
    "gcloud config",        // Google Cloud — config contains the active credential path
    "gcloud auth print-access-token",
    "az account",           // Azure CLI — `az account get-access-token` returns a bearer
    "azd auth token",       // Azure Developer CLI
    "aws configure",        // Not in the published list; same objective, same primitive.
    "aws sts get-caller-identity",
    "kubectl config view"   // Kubernetes configs are named in the blog's stated objectives.
]);
DeviceProcessEvents
| where Timestamp > ago(1h)
// Bun as the PARENT is the signal. The child is an ordinary, signed, expected binary, so
// filtering on the child alone would drown in developer activity.
| where InitiatingProcessFileName in~ ("bun","bun.exe","bunx","bunx.exe")
| extend CommandLower = tolower(ProcessCommandLine)
| where CommandLower has_any (CredentialCommands)
    // A shell spawned by Bun is the same behaviour one indirection further out, and is how
    // the same objective looks when the payload pipes through cmd/powershell/sh.
    or (FileName in~ ("cmd.exe","powershell.exe","pwsh.exe","sh","bash","zsh")
        and CommandLower has_any (CredentialCommands))
| extend TargetedCredential = case(
    CommandLower has "gh auth",     "GitHub token",
    CommandLower has "gcloud",      "Google Cloud",
    CommandLower has "az account" or CommandLower has "azd auth", "Azure",
    CommandLower has "aws",         "AWS",
    CommandLower has "kubectl",     "Kubernetes config",
    "unclassified")
| project Timestamp, ReportId, DeviceId, DeviceName, AccountName, AccountDomain, AccountSid,
          TargetedCredential, FileName, FolderPath, ProcessCommandLine, SHA256,
          InitiatingProcessFileName, InitiatingProcessCommandLine,
          InitiatingProcessFolderPath, InitiatingProcessSHA256
| limit 1000
