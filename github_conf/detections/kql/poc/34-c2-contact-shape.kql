// 34 — PoC: is RemoteUrl populated for node network traffic?  (rule 14, c2-contact)
//
// This is the most valuable query in the PoC set, because rule 14 is the one most likely
// to be silently dead. It matches RemoteUrl in DeviceNetworkEvents; RemoteUrl is populated
// by Network Protection. Without it, rule 14 validates, deploys, schedules, runs hourly,
// and can never produce a single alert — while appearing on every dashboard as coverage.
//
// coverage/04 asks whether Network Protection is configured. coverage/05 asks whether it
// emits events. This asks the only question that actually matters for the rule: does a
// NODE process's outbound connection arrive with a URL attached?
//
// Risk: NONE. Form A hunts existing telemetry. Form B fetches a benign public URL and
// matches no rule.
//
// ---------------------------------------------------------------------------------------
// FORM A — no trigger.
// ---------------------------------------------------------------------------------------

let Platform =
    DeviceInfo
    | where Timestamp > ago(7d)
    | summarize arg_max(Timestamp, OSPlatform) by DeviceId
    | project DeviceId, OSPlatform;
DeviceNetworkEvents
| where Timestamp > ago(7d)
| where InitiatingProcessFileName in~ ("node","node.exe","bun","bun.exe","bunx",
                                      "npm","npm.exe","npm-cli.js","pnpm","yarn")
| join kind=leftouter Platform on DeviceId
| extend Plat = iff(isempty(OSPlatform), "unknown", OSPlatform)
| summarize Connections  = count(),
            Devices      = dcount(DeviceId),
            WithUrl      = countif(isnotempty(RemoteUrl)),
            WithIpOnly   = countif(isempty(RemoteUrl) and isnotempty(RemoteIP)),
            NoDeviceId   = countif(isempty(DeviceId)),
            NoAccountSid = countif(isempty(InitiatingProcessAccountSid)),
            SampleUrls   = make_set_if(RemoteUrl, isnotempty(RemoteUrl), 10)
    by Plat
| extend UrlCoveragePct = round(100.0 * WithUrl / Connections, 1)
| extend Verdict = case(
    Connections == 0,      "FAIL - no node network telemetry at all on this platform",
    WithUrl == 0,          "FAIL - RULE 14 IS DEAD HERE. RemoteUrl never populated; enable Network Protection (audit mode is enough)",
    UrlCoveragePct < 50.0, "WARN - rule 14 has partial coverage only; do not read its zero as clean",
    "PASS - RemoteUrl populated; rule 14 can fire")
| order by Connections desc
| limit 50

// ---------------------------------------------------------------------------------------
// FORM B — benign trigger. Proves URL capture end to end for a node process.
//
// Uses the real npm registry, which every dev machine contacts anyway. No IOC domain is
// contacted, so no deployed rule can match.
//
//   node -e "require('https').get('https://registry.npmjs.org/keyv', r => { \
//            console.log(r.statusCode); r.resume(); })"
//
//   DeviceNetworkEvents
//   | where Timestamp > ago(1h)
//   | where InitiatingProcessFileName in~ ("node","node.exe")
//   | where RemoteUrl has "registry.npmjs.org"
//   | project Timestamp, ReportId, DeviceId, DeviceName, RemoteUrl, RemoteIP, RemotePort,
//             ActionType, InitiatingProcessFileName, InitiatingProcessCommandLine,
//             InitiatingProcessAccountName, InitiatingProcessAccountSid
//   | limit 100
//
// A row WITH RemoteUrl populated is the proof. A row with only RemoteIP means rule 14
// needs Network Protection before it counts as coverage — and note that node ships its own
// TLS stack, so URL capture can be partial even where Network Protection is on. Treat
// partial as partial in the coverage report; do not round it up.
// ---------------------------------------------------------------------------------------
