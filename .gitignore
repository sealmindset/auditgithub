scripts/azure-login/screenshots/*.png

# Scanner and export artifacts.
# exports/ holds raw scanner output, including findings_all.csv, which contains the
# plaintext secrets the scanner recovered from the estate (private keys, PATs). It must
# never be committed: publishing it would leak every credential it found, and git history
# cannot be un-published. The rest of exports/ is regenerable, so nothing is lost.
exports/
.scan_resume_state.pkl

# Local TLS trust material. The corporate TLS-inspection root CA is host-specific
# and names our proxy setup, so it stays out of a repository whose origin is
# public. The directory itself is tracked because Dockerfile.scanner does
# `COPY certs/`, and a COPY of a missing directory fails the build outright — so
# a fresh clone needs the directory to exist even when it is empty.
certs/*
!certs/.gitkeep

# Local UI/report capture artifacts
.try-it-screenshots/
TRY-IT-REPORT.md

# Python bytecode
__pycache__/
*.pyc

# Registry lookup cache written by the npm supply-chain scans (one JSON per
# package, hundreds of files). Regenerable from the registry; never commit.
.cache/
